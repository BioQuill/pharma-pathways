  "card_display": {
    "card_title": "LP%",
    "card_subtitle": "Industry Phase Success Rate",
    "three_outputs": [
      {
        "id": "phase_lp",
        "label": "LP% \u2014 Industry Phase Success Rate",
        "description": "Probability of reaching commercial launch for a molecule at this development phase \u2014 industry-wide average across all therapeutic areas.",
        "example": "Phase 1 (all TAs): 8.1%",
        "source_field": "phase_lp.values[molecule.phase]"
      },
      {
        "id": "ta_lp",
        "label": "LP% \u2014 Industry TA Success Rate",
        "description": "Probability of reaching commercial launch for a molecule at this phase within this specific therapeutic area \u2014 TA-calibrated industry average.",
        "example": "Phase 1 \u00b7 Oncology: 7.4%",
        "source_field": "ta_specific_transitions[molecule.ta].lp_by_phase[molecule.phase]"
      },
      {
        "id": "phase_x_ta_delta",
        "label": "\u0394 LP%",
        "sublabel": "vs Industry Delta",
        "description": "Difference between the TA-specific success rate and the industry-wide phase average. Shows whether this TA is structurally easier or harder than the industry average for this phase.",
        "calculation": "ta_lp - phase_lp (delta, not multiplication)",
        "unit": "percentage points (pp)",
        "example": "Oncology Phase 1: 7.4% - 8.1% = -0.8pp",
        "statistical_note": "Delta is the correct third metric \u2014 TA LP% and Phase LP% are not independent probabilities and should not be multiplied. The delta shows TA-specific structural deviation from industry average.",
        "interpretation": {
          "positive": "This TA outperforms the industry phase average \u2014 structural tailwind. Example: Rare Disease Phase 1 +7.4pp means rare disease molecules historically launch at nearly double the industry Phase 1 rate.",
          "negative": "This TA underperforms the industry phase average \u2014 structural headwind. Example: Neurology Phase 1 -3.2pp means neurology molecules face significantly harder path than industry average.",
          "zero": "This TA performs in line with the industry phase average \u2014 no structural advantage or disadvantage.",
          "na": "Not applicable for PK & Pharmacology trials."
        },
        "label_unicode": "\u0394 LP%",
        "label_display": "\u0394 LP%",
        "inline_description": "How much this TA deviates from industry average",
        "what_this_means": {
          "positive": "This TA outperforms the industry phase average \u2014 structural tailwind for molecules in this area.",
          "negative": "This TA underperforms the industry phase average \u2014 structural headwind to account for.",
          "zero": "This TA performs in line with the industry phase average."
        }
      }
    ],
    "what_this_means_logic": {
      "all_positive": "Both phase and TA success rates are above industry average \u2014 structurally favourable pipeline position.",
      "ta_below_phase": "This TA underperforms the industry phase average ({delta}pp below). Structural headwind \u2014 TA-specific challenges apply.",
      "ta_above_phase": "This TA outperforms the industry phase average (+{delta}pp above). Structural tailwind \u2014 TA-specific advantages apply.",
      "na": "LP% is not applicable for PK & Pharmacology trials \u2014 healthy volunteer studies have no defined approval pathway."
    },
    "na_condition": "therapeutic_area === 'PK & Pharmacology'"
  },
