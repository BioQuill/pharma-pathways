  "metadata": {
    "version": "2.0",
    "description": "BioQuill PTRS calibration data \u2014 PTS base rates and PRS empirical rates",
    "pts_source": "BIO/Norstella Industry Analysis 2011\u20132023 phase transition rates",
    "prs_source": "BioQuill empirical data \u2014 1,327 terminal molecules from 14,000-trial dataset",
    "last_updated": "2026-03-06",
    "notes": "PTS = probability of advancing from current phase to next gate. PRS = probability of NDA/BLA approval given submission."
  },
