  "formula_reference": {
    "pts_formula": "basePTS_rate(TA, phase) * avg(sliderMultiplier(mechNovelty), sliderMultiplier(endpointClarity), sliderMultiplier(priorTrialData))",
    "prs_formula": "basePRS_rate(TA) * avg(sliderMultiplierPRS(sponsorExp, base), sliderMultiplierPRS(regPrecedent, base), sliderMultiplierPRS(safetyProfile, base))",
    "ptrs_formula": "PTS * PRS",
    "slider_logic_note": "50% slider = 1.00x (industry average). Below 50% = discount. Above 50% = premium. PRS uses asymmetric multiplier when base rate >= 0.80.",
    "worked_example": {
      "inputs": {
        "ta": "Oncology & Hematology",
        "phase": "Phase 2",
        "mechanism_novelty": 50,
        "endpoint_clarity": 70,
        "prior_trial_data": 60,
        "sponsor_experience": 65,
        "regulatory_precedent": 75,
        "safety_profile": 70
      },
      "step_by_step": {
        "base_pts_rate": "0.32 (Oncology Ph2 to Ph3, BIO/Norstella)",
        "pts_modifiers": {
          "mechanism_novelty_50": "1.00x",
          "endpoint_clarity_70": "1.20x",
          "prior_trial_data_60": "1.00x"
        },
        "pts_modifier_avg": "1.067x",
        "pts_result": "0.32 * 1.067 = 34.1%",
        "base_prs_rate": "0.89 (Oncology empirical: 582/654 terminal molecules)",
        "prs_asymmetric": true,
        "prs_modifiers": {
          "sponsor_experience_65": "1.05x",
          "regulatory_precedent_75": "1.05x",
          "safety_profile_70": "1.05x"
        },
        "prs_modifier_avg": "1.05x",
        "prs_result": "0.89 * 1.05 = 93.5%",
        "ptrs_result": "34.1% * 93.5% = 31.9%"
      },
      "old_broken_values": {
        "pts": "10.1%",
        "prs": "92.3%",
        "ptrs": "9.3%",
        "issue": "PTS arithmetic not reproducible from inputs. PRS not phase-conditioned. Monte Carlo applied to output not inputs."
      }
    }
  }
