  "monte_carlo_config": {
    "description": "Configuration for Monte Carlo uncertainty propagation engine",
    "default_iterations": 10000,
    "default_uncertainty_pct": 0.15,
    "base_rate_uncertainty": {
      "pts_relative_sd": 0.12,
      "prs_relative_sd": 0.08,
      "note": "Base transition rates are themselves uncertain. PTS +/-12% relative SD, PRS +/-8% relative SD from literature variance."
    },
    "clamp_values": {
      "pts_min": 0.03,
      "pts_max": 0.95,
      "prs_min": 0.1,
      "prs_max": 0.98,
      "ptrs_min": 0.01,
      "ptrs_max": 0.95
    },
    "expected_outputs_validation": {
      "scenario": "Oncology Phase 2, all sliders at average (50%), uncertainty +/-15%",
      "mean_ptrs": "32.3%",
      "median_ptrs": "32.0%",
      "std_dev": "6.0%",
      "p5": "22.8%",
      "p95": "42.7%",
      "old_broken_std_dev": "0.22%",
      "old_broken_p5_p95_range": "0.71pp",
      "new_p5_p95_range": "19.9pp"
    }
